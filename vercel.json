{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/join",
      "destination": "https://ghostai-member.vercel.app/signup",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "https://ghostai-member.vercel.app",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ghostai-web.vercel.app"
        }
      ],
      "destination": "https://www.ghostai.co.kr/:path*",
      "permanent": true
    }
  ]
}
